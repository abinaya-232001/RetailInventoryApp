<UserControl x:Class="RetailInventoryApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="28">
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="6" Margin="0,0,8,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Total Products" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="TxtTotalProducts" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="6" Margin="4,0,4,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Low Stock Items" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="TxtLowStock" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="6" Margin="4,0,4,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Today's Revenue" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="TxtTodayRevenue" Text="Rs. 0.00" FontSize="26" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="White" CornerRadius="6" Margin="8,0,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Today's Transactions" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="TxtTodayTx" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Products at or below reorder level" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource PrimaryBrush}"/>
                    <Border Background="White" CornerRadius="6">
                        <Grid>
                            <DataGrid x:Name="GridLowStock" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="34"
                                      Background="White" BorderThickness="0" CanUserAddRows="False" MinHeight="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/>
                                    <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                                    <DataGridTextColumn Header="Current Stock" Binding="{Binding StockQuantity}" Width="120"/>
                                    <DataGridTextColumn Header="Reorder Level" Binding="{Binding ReorderLevel}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="TxtNoLowStock" Text="All products are currently above their reorder level."
                                       Foreground="Gray" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,40,0,0"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Top Selling Products" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource PrimaryBrush}"/>
                    <Border Background="White" CornerRadius="6" Padding="4">
                        <Grid>
                            <DataGrid x:Name="GridTopProducts" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="34"
                                      Background="White" BorderThickness="0" CanUserAddRows="False" MinHeight="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="Units Sold" Binding="{Binding TotalQuantity}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="TxtNoTopProducts" Text="No sales recorded yet."
                                       Foreground="Gray" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,40,0,0"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
