<UserControl x:Class="RetailInventoryApp.Views.StockManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Stock Management" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="All Products" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtSearch" Grid.Row="1" Padding="8" Margin="0,0,0,10" TextChanged="TxtSearch_TextChanged"
                             Tag="Search by SKU or product name..."/>
                    <DataGrid x:Name="GridStock" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="32"
                              SelectionMode="Single" SelectionChanged="GridStock_SelectionChanged"
                              BorderThickness="0" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="70"/>
                            <DataGridTextColumn Header="Reorder Lvl" Binding="{Binding ReorderLevel}" Width="90"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                        <Setter Property="Background" Value="#FDEBD0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="TxtSelectedProduct" Text="Select a product to adjust stock" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="Movement Type" FontSize="11" Foreground="Gray"/>
                        <ComboBox x:Name="CmbMovementType" Margin="0,4,0,10" Padding="6" SelectedIndex="0">
                            <ComboBoxItem Content="Stock In (received new stock)" Tag="StockIn"/>
                            <ComboBoxItem Content="Stock Out (damaged / expired / lost)" Tag="StockOut"/>
                            <ComboBoxItem Content="Adjustment (positive correction)" Tag="Adjustment"/>
                        </ComboBox>

                        <TextBlock Text="Quantity" FontSize="11" Foreground="Gray"/>
                        <TextBox x:Name="TxtAdjustQty" Padding="6" Margin="0,4,0,10"/>

                        <TextBlock Text="Reason / Note" FontSize="11" Foreground="Gray"/>
                        <TextBox x:Name="TxtReason" Padding="6" Margin="0,4,0,10"/>

                        <Button x:Name="BtnApplyAdjustment" Content="Apply Stock Update" Style="{StaticResource PrimaryButtonStyle}" Click="BtnApplyAdjustment_Click"/>
                        <TextBlock x:Name="TxtStockMessage" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <StackPanel>
                            <TextBlock Text="Recent Movements" FontWeight="SemiBold" Margin="0,4,0,8"/>
                            <DataGrid x:Name="GridMovements" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="30"
                                      BorderThickness="0" CanUserAddRows="False" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding MovementDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="90"/>
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <TextBlock x:Name="TxtNoMovements" Text="No stock movements recorded yet for this product."
                                   Foreground="Gray" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,70,0,0"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
