<UserControl x:Class="RetailInventoryApp.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sales" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="TxtSearch" Grid.Row="0" Padding="8" Margin="0,0,0,10" TextChanged="TxtSearch_TextChanged"/>

                    <DataGrid x:Name="GridCatalog" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="32"
                              SelectionMode="Single" BorderThickness="0" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="In Stock" Binding="{Binding StockQuantity}" Width="80"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                        <Setter Property="Background" Value="#FDEBD0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="Highlighted rows are at or below reorder level." FontSize="11" Foreground="Gray" FontStyle="Italic" Margin="0,6,0,0"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Qty:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtQty" Width="60" Padding="6" Text="1"/>
                        <Button x:Name="BtnAddToCart" Content="Add to Cart" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0" Click="BtnAddToCart_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Current Sale" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="GridCart" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="32"
                                  SelectionMode="Single" BorderThickness="0" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="80"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="TxtEmptyCart" Text="Your cart is empty. Select a product and click Add to Cart."
                                   Foreground="Gray" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,40,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" Width="220"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnRemoveLine" Content="Remove Selected" Click="BtnRemoveLine_Click" Padding="10,6" Margin="0,0,8,0"/>
                        <Button x:Name="BtnClearCart" Content="Clear Cart" Click="BtnClearCart_Click" Padding="10,6"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <Separator Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtGrandTotal" Text="Total: Rs. 0.00" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtSalesMessage" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,6"/>
                        <Button x:Name="BtnCompleteSale" Content="Complete Sale" Style="{StaticResource PrimaryButtonStyle}"
                                Background="{StaticResource SuccessBrush}" Click="BtnCompleteSale_Click" Height="42"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
